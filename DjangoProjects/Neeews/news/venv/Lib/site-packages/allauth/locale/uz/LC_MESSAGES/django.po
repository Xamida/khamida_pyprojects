#: .\venv\Lib\site-packages\allauth\idp\oidc\internal\clientkit.py:24
msgid "Wildcards are not allowed unless 'Allow URI wildcards' is enabled."
msgstr ""
"'URI joker belgilariga ruxsat berish' yoqilmagan bo'lsa, joker belgilarga "
"ruxsat berilmaydi."

#: .\venv\Lib\site-packages\allauth\idp\oidc\internal\clientkit.py:29
#, python-brace-format
msgid ""
